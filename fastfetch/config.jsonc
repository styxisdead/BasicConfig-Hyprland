{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "builtin",
        "source": "arch",
        "padding": {
            "right": 3
        },
        "color": {
            "1": "#9ecafc",
            "2": "#bac8db",
            "3": "#d5bee5",
            "4": "#154974",
            "5": "#e0e2e8",
            "6": "#3b4857"
        }
    },

    "display": {
        "separator": "  "
    },

    "modules": [
        {
            "type": "title",
            "color": {
                "user": "#9ecafc",
                "at": "#bac8db",
                "host": "#d5bee5"
            }
        },

        {
            "type": "separator",
            "string": "────────────────────────"
        },

        {
            "type": "os",
            "key": "OS",
            "keyColor": "#9ecafc"
        },
        {
            "type": "host",
            "key": "Host",
            "keyColor": "#bac8db"
        },
        {
            "type": "kernel",
            "key": "Kernel",
            "keyColor": "#d5bee5"
        },
        {
            "type": "uptime",
            "key": "Uptime",
            "keyColor": "#9ecafc"
        },
        {
            "type": "packages",
            "key": "Packages",
            "keyColor": "#bac8db"
        },
        {
            "type": "shell",
            "key": "Shell",
            "keyColor": "#d5bee5"
        },
        {
            "type": "wm",
            "key": "WM",
            "keyColor": "#9ecafc"
        },
        {
            "type": "terminal",
            "key": "Terminal",
            "keyColor": "#bac8db"
        },
        {
            "type": "cpu",
            "key": "CPU",
            "keyColor": "#d5bee5"
        },
        {
            "type": "gpu",
            "key": "GPU",
            "keyColor": "#9ecafc"
        },
        {
            "type": "memory",
            "key": "Memory",
            "keyColor": "#bac8db"
        },

        "break",

        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
