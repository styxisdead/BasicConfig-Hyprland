{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "builtin",
        "source": "arch",
        "padding": {
            "right": 3
        },
        "color": {
            "1": "#ffb1c1",
            "2": "#e4bdc3",
            "3": "#ecbe91",
            "4": "#713343",
            "5": "#efdee0",
            "6": "#5b3f45"
        }
    },

    "display": {
        "separator": "  "
    },

    "modules": [
        {
            "type": "title",
            "color": {
                "user": "#ffb1c1",
                "at": "#e4bdc3",
                "host": "#ecbe91"
            }
        },

        {
            "type": "separator",
            "string": "────────────────────────"
        },

        {
            "type": "os",
            "key": "OS",
            "keyColor": "#ffb1c1"
        },
        {
            "type": "host",
            "key": "Host",
            "keyColor": "#e4bdc3"
        },
        {
            "type": "kernel",
            "key": "Kernel",
            "keyColor": "#ecbe91"
        },
        {
            "type": "uptime",
            "key": "Uptime",
            "keyColor": "#ffb1c1"
        },
        {
            "type": "packages",
            "key": "Packages",
            "keyColor": "#e4bdc3"
        },
        {
            "type": "shell",
            "key": "Shell",
            "keyColor": "#ecbe91"
        },
        {
            "type": "wm",
            "key": "WM",
            "keyColor": "#ffb1c1"
        },
        {
            "type": "terminal",
            "key": "Terminal",
            "keyColor": "#e4bdc3"
        },
        {
            "type": "cpu",
            "key": "CPU",
            "keyColor": "#ecbe91"
        },
        {
            "type": "gpu",
            "key": "GPU",
            "keyColor": "#ffb1c1"
        },
        {
            "type": "memory",
            "key": "Memory",
            "keyColor": "#e4bdc3"
        },

        "break",

        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
