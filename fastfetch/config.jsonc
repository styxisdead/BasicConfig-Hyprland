{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "builtin",
        "source": "arch",
        "padding": {
            "right": 3
        },
        "color": {
            "1": "#c2c1ff",
            "2": "#c6c4dd",
            "3": "#e9b9d2",
            "4": "#414178",
            "5": "#e4e1e9",
            "6": "#454559"
        }
    },

    "display": {
        "separator": "  "
    },

    "modules": [
        {
            "type": "title",
            "color": {
                "user": "#c2c1ff",
                "at": "#c6c4dd",
                "host": "#e9b9d2"
            }
        },

        {
            "type": "separator",
            "string": "────────────────────────"
        },

        {
            "type": "os",
            "key": "OS",
            "keyColor": "#c2c1ff"
        },
        {
            "type": "host",
            "key": "Host",
            "keyColor": "#c6c4dd"
        },
        {
            "type": "kernel",
            "key": "Kernel",
            "keyColor": "#e9b9d2"
        },
        {
            "type": "uptime",
            "key": "Uptime",
            "keyColor": "#c2c1ff"
        },
        {
            "type": "packages",
            "key": "Packages",
            "keyColor": "#c6c4dd"
        },
        {
            "type": "shell",
            "key": "Shell",
            "keyColor": "#e9b9d2"
        },
        {
            "type": "wm",
            "key": "WM",
            "keyColor": "#c2c1ff"
        },
        {
            "type": "terminal",
            "key": "Terminal",
            "keyColor": "#c6c4dd"
        },
        {
            "type": "cpu",
            "key": "CPU",
            "keyColor": "#e9b9d2"
        },
        {
            "type": "gpu",
            "key": "GPU",
            "keyColor": "#c2c1ff"
        },
        {
            "type": "memory",
            "key": "Memory",
            "keyColor": "#c6c4dd"
        },

        "break",

        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
