font=Sans 11

background-color=#191113aa
text-color=#efdee0ff
border-color=#ffb1c1ff
progress-color=over #ffb1c1ff

border-size=2
border-radius=12

width=380
height=120
padding=14
margin=18
outer-margin=0

default-timeout=5000
ignore-timeout=0

max-visible=5
layer=overlay

icons=1
max-icon-size=48

anchor=top-right

group-by=app-name
format=<b>%s</b>\n%b

[urgency=low]
border-color=#e4bdc3ff
default-timeout=3000

[urgency=normal]
border-color=#ffb1c1ff
default-timeout=5000

[urgency=critical]
background-color=#93000aff
border-color=#ffb4abff
text-color=#ffdad6ff
default-timeout=0
