font=Sans 11

background-color=#131318aa
text-color=#e4e1e9ff
border-color=#c2c1ffff
progress-color=over #c2c1ffff

border-size=2
border-radius=12

width=380
height=120
padding=14
margin=18
outer-margin=0

default-timeout=5000
ignore-timeout=0

max-visible=5
layer=overlay

icons=1
max-icon-size=48

anchor=top-right

group-by=app-name
format=<b>%s</b>\n%b

[urgency=low]
border-color=#c6c4ddff
default-timeout=3000

[urgency=normal]
border-color=#c2c1ffff
default-timeout=5000

[urgency=critical]
background-color=#93000aff
border-color=#ffb4abff
text-color=#ffdad6ff
default-timeout=0
